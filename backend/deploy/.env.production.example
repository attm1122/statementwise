# Statementwise API production environment
# Copy these into your backend host secret manager. Do not commit real values.

ENV=production
DEBUG=false
SECRET_KEY=replace-with-openssl-rand-base64-48

DATABASE_URL=postgresql+asyncpg://statementwise:replace-password@db.example.com:5432/statementwise
REDIS_URL=rediss://default:replace-password@redis.example.com:6379/0

CORS_ORIGINS=["https://statementwiseai.com","https://www.statementwiseai.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type","X-Requested-With","X-Refresh-Token"]

MOONSHOT_API_KEY=sk-live-replace
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_ACCESS_KEY=replace
S3_SECRET_KEY=replace
S3_BUCKET_PDFS=statementwise-prod-pdfs
S3_BUCKET_EXPORTS=statementwise-prod-exports
S3_REGION=us-east-1
S3_USE_SSL=true

WEBHOOK_SECRET=replace-with-openssl-rand-base64-48

ENABLE_BILLING=true
STRIPE_SECRET_KEY=sk_live_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_PRICE_BASIC_ID=price_replace
STRIPE_PRICE_PRO_ID=price_replace
STRIPE_PRICE_ENTERPRISE_ID=price_replace

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@statementwiseai.com
SMTP_PASSWORD=replace
SMTP_FROM_EMAIL=noreply@statementwiseai.com
SMTP_TLS=true
