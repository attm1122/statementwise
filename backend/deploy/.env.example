# Statementwise API - Environment Configuration Template
# Copy to .env and fill in values

# ── Application ──────────────────────────────────────────────────
ENV=production
DEBUG=false
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://statementwise:your-db-password@postgres:5432/statementwise

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Moonshot AI ──────────────────────────────────────────────────
# Get your API key from: https://platform.moonshot.ai
MOONSHOT_API_KEY=sk-your-moonshot-api-key
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ── MinIO / S3 ───────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PDFS=statementwise-pdfs
S3_BUCKET_EXPORTS=statementwise-exports

# ── Stripe (Billing) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC_ID=price_...
STRIPE_PRICE_PRO_ID=price_...
STRIPE_PRICE_ENTERPRISE_ID=price_...

# ── Email (SMTP) ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@statementwise.ai
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@statementwise.ai

# ── Monitoring ───────────────────────────────────────────────────
FLOWER_AUTH=admin:secure_password
