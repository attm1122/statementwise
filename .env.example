# =============================================================================
# Statementwise.ai - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env or .env.local to version control.
# These files are already listed in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
# Application environment: development | staging | production
VITE_APP_ENV=development

# Application name displayed in the UI
VITE_APP_NAME=Statementwise.ai

# Application version (should match package.json)
VITE_APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# API Configuration
# ---------------------------------------------------------------------------
# Base URL for the Statementwise API
# - Development: http://localhost:8080/v1
# - Staging: https://api-staging.statementwise.ai/v1
# - Production: https://api.statementwise.ai/v1
VITE_API_BASE_URL=https://api.statementwise.ai/v1

# API timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# OAuth / SSO provider configuration
# VITE_AUTH_CLIENT_ID=your_auth_client_id
# VITE_AUTH_DOMAIN=your_auth_domain.auth0.com
# VITE_AUTH_REDIRECT_URI=https://statementwise.ai/callback

# ---------------------------------------------------------------------------
# Security Settings
# ---------------------------------------------------------------------------
# Content Security Policy report URI (optional)
# If set, CSP violations will be reported to this endpoint
# VITE_CSP_REPORT_URI=https://api.statementwise.ai/v1/security/csp-report

# Sentry DSN for error tracking (optional)
# VITE_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Feature flags for security features
VITE_ENABLE_SECURE_HEADERS=true

# ---------------------------------------------------------------------------
# Analytics (Optional - Disabled by default for privacy)
# ---------------------------------------------------------------------------
# Google Analytics Measurement ID (only enable in production)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog API Key (optional)
# VITE_POSTHOG_KEY=phc_your_posthog_key

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
# Enable/disable specific features
VITE_FEATURE_CLIENT_PORTALS=true
VITE_FEATURE_API_ACCESS=true
VITE_FEATURE_BULK_UPLOAD=false

# ---------------------------------------------------------------------------
# Security Notes
# ---------------------------------------------------------------------------
# 1. NEVER commit real API keys or secrets to version control
# 2. Use environment-specific .env files:
#    - .env.development (shared dev defaults)
#    - .env.local (local overrides - NEVER commit)
#    - .env.production (production overrides)
#
# 3. API keys should be rotated regularly (recommended: every 90 days)
# 4. All API communication uses HTTPS in production
# 5. Authentication tokens should be stored in httpOnly cookies,
#    NOT in localStorage or sessionStorage
#
# 6. For GitHub Pages deployment:
#    - Environment variables starting with VITE_ are bundled at build time
#    - Non-VITE_ prefixed variables are NOT exposed to the client
#
# 7. Sensitive data that should NEVER be in client bundle:
#    - API secrets or server-side keys
#    - Database connection strings
#    - Private keys or certificates
#    - Internal network addresses
# =============================================================================
