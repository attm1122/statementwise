# Statementwise.ai frontend production environment
# Copy values into Vercel Project Settings. Do not commit real secrets.

VITE_APP_ENV=production
VITE_APP_NAME=Statementwise.ai
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=https://api.statementwiseai.com/v1
VITE_API_URL=https://api.statementwiseai.com/v1
VITE_API_TIMEOUT=30000
VITE_ENABLE_SECURE_HEADERS=true
VITE_FEATURE_CLIENT_PORTALS=true
VITE_FEATURE_API_ACCESS=true
VITE_FEATURE_BULK_UPLOAD=false

# Optional monitoring. Only set this after the Sentry project is configured.
# VITE_SENTRY_DSN=https://public-key@sentry.io/project-id
